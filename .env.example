# Arrow Assistant needs at most two keys, and both have free tiers.
# You can also go fully free with no keys using the local fallbacks.

# LLM (vision) - pick ONE:
#   Google AI Studio free key: https://aistudio.google.com/apikey  (recommended, free tier)
GEMINI_API_KEY=
#   ...or an OpenRouter key (free models available): https://openrouter.ai/keys
OPENROUTER_API_KEY=
#   ...or an NVIDIA Build key (free): https://build.nvidia.com
NVIDIA_API_KEY=

# STT - Groq free tier: https://console.groq.com/keys
#   Leave empty to use local faster-whisper instead (no key, works offline, slower).
GROQ_API_KEY=

# TTS - no key needed. Uses edge-tts (free) with pyttsx3 (local) as offline fallback.

# Optional overrides
ARROW_HOTKEY=ctrl+alt+space
# Leave commented to use the built-in default (gemini-3.8-flash).
# gemini-2.5-* is limited to existing users on the Gemini API.
# ARROW_GEMINI_MODEL=gemini-3.8-flash
# ARROW_AGENT_GEMINI_MODEL=gemini-3.8-flash
