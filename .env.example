# Arrow Assistant needs at most two keys, and both have free tiers.
# You can also go fully free with no keys using the local fallbacks.

# LLM (vision) - pick ONE:
#   Google AI Studio free key: https://aistudio.google.com/apikey  (recommended, free tier)
GEMINI_API_KEY=
#   ...or an OpenRouter key (free models available): https://openrouter.ai/keys
OPENROUTER_API_KEY=
#   ...or an NVIDIA Build key (free): https://build.nvidia.com
NVIDIA_API_KEY=

# STT - Groq free tier: https://console.groq.com/keys
#   Leave empty to use local faster-whisper instead (no key, works offline, slower).
GROQ_API_KEY=

# TTS - no key needed. Uses edge-tts (free) with pyttsx3 (local) as offline fallback.

# Optional overrides
ARROW_HOTKEY=ctrl+alt+space
# Leave commented to use the built-in default (gemini-3.8-flash).
# gemini-2.5-* is limited to existing users on the Gemini API.
# ARROW_GEMINI_MODEL=gemini-3.8-flash
# ARROW_AGENT_GEMINI_MODEL=gemini-3.8-flash

# Agent tools (see docs/AGENT.md). PowerShell always asks before it runs.
# ARROW_AGENT_TOOLS=web,files,powershell
# ARROW_AGENT_PS_MODE=safe        # safe = read-only allowlist (default) | approve = wider, still asks
# ARROW_AGENT_WORKSPACE=C:\Users\you\Documents\Arrow Workspace

# Usage guard (see README "Will this cost me money?"). These are Arrow's own
# conservative warnings, NOT the providers' limits: check each provider's
# rate-limit page and adjust. Counts are per local day in %APPDATA%\Arrow\usage.json.
# Tray + one spoken line at 80% and 100% of the warn budget (once each per day).
# ARROW_DAILY_REQUEST_WARN=100            # all providers (defaults: gemini 100, openrouter 40, nvidia 300, groq 500)
# ARROW_DAILY_REQUEST_WARN_GEMINI=100     # per-provider override (_GEMINI/_OPENROUTER/_NVIDIA/_GROQ)
# ARROW_DAILY_TOKEN_WARN=1000000
# Hard stop: refuse new calls to that provider for the rest of the day (off by default).
# ARROW_DAILY_REQUEST_LIMIT=0
# ARROW_DAILY_TOKEN_LIMIT=0
# ARROW_USAGE_ALERTS=1                    # 0 = keep counting, no tray/voice alerts
